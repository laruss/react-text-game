{
    "name": "@react-text-game/messenger",
    "version": "0.1.0",
    "description": "Headless messenger and visual-novel transcript engine for React Text Game: persistent message logs, seen tracking, group chats, media albums and scheduled delivery",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "repository": "github:laruss/react-text-game",
    "homepage": "https://reacttextgame.dev/",
    "private": false,
    "sideEffects": [
        "./dist/i18n/index.js"
    ],
    "type": "module",
    "scripts": {
        "dev": "tsc -p tsconfig.build.json --watch & tsc-alias -p tsconfig.build.json --watch",
        "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "test": "bun test --cwd ../.. packages/messenger/src/tests",
        "test:coverage": "bun test --cwd ../.. --coverage --coverage-dir packages/messenger/coverage packages/messenger/src/tests && bun ../../scripts/check-coverage.ts packages/messenger",
        "check-types": "tsc --noEmit",
        "lint": "biome check --error-on-warnings .",
        "prepack": "bun run build",
        "test-pack": "bun pm pack --dry-run && bunx --bun publint"
    },
    "author": "laruss",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "license": "MIT",
    "files": [
        "dist"
    ],
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "@react-text-game/core": ">=0.9.0"
    },
    "devDependencies": {
        "@react-text-game/core": "workspace:*",
        "@types/bun": "1.3.9",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "tsc-alias": "^1.8.16"
    },
    "imports": {
        "#*": "./dist/*"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    }
}
