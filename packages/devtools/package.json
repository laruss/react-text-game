{
    "name": "@react-text-game/devtools",
    "version": "0.1.0",
    "description": "Development-time CLI for React Text Game: detects whether a save migration is needed by diffing your game's save schema against a committed baseline",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/laruss/react-text-game.git",
        "directory": "packages/devtools"
    },
    "homepage": "https://reacttextgame.dev/",
    "private": false,
    "sideEffects": false,
    "type": "module",
    "bin": {
        "rtg": "dist/bin.js"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsc -p tsconfig.build.json --watch & tsc-alias -p tsconfig.build.json --watch",
        "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "test": "bun test --cwd ../.. packages/devtools/src/tests",
        "test:coverage": "bun test --cwd ../.. --coverage --coverage-dir packages/devtools/coverage packages/devtools/src/tests && bun ../../scripts/check-coverage.ts packages/devtools",
        "check-types": "tsc --noEmit",
        "lint": "biome check --error-on-warnings .",
        "prepack": "bun run build",
        "test-pack": "bun pm pack --dry-run && bunx --bun publint"
    },
    "author": "laruss",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "license": "MIT",
    "files": [
        "dist"
    ],
    "peerDependencies": {
        "@react-text-game/core": ">=0.10.0"
    },
    "devDependencies": {
        "@react-text-game/core": "workspace:*",
        "@types/bun": "1.3.9",
        "@types/node": "^24.6.2",
        "tsc-alias": "^1.8.16"
    },
    "imports": {
        "#*": "./dist/*"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    }
}
