{
    "compilerOptions": {
        // File Layout
        "rootDir": "./src",
        "outDir": "./dist",

        // Environment Settings
        // This package runs in a terminal under Node or Bun, never in a browser,
        // so it takes node types and no DOM lib.
        "module": "esnext",
        "target": "esnext",
        "lib": ["esnext"],
        "moduleResolution": "bundler",
        "types": ["bun", "node"],

        // Other Outputs
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,

        // Stricter Typechecking Options
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "allowArbitraryExtensions": false,

        // Recommended Options
        "strict": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "#*": ["./src/*"]
        }
    },
    "include": ["src"],
    "exclude": ["dist", "node_modules"]
}
